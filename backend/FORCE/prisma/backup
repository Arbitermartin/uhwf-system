model Backup {
  id          Int        @id @default(autoincrement())
  kind        BackupKind
  fileName    String
  sizeMb      Int
  createdById Int?
  createdAt   DateTime   @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("backups")
}
